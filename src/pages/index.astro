---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <h1>Development diary</h1>
  <p class="muted">Daily notes on building <strong>Backseat</strong>: a VR experience where you ride in the back of a taxi through a minimalist world that changes with the music you pick.</p>
  <ul class="posts">
    {posts.map((p) => (
      <li>
        <time datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time><br />
        <a href={`${base}/posts/${p.id}/`}>{p.data.title}</a>
        {p.data.summary && <div class="muted">{p.data.summary}</div>}
        <div>{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
      </li>
    ))}
  </ul>
</Base>

---
import '../styles/global.css';
import type { Bg } from '../lib';
interface Props { title?: string; description?: string; bg?: Bg; section?: string; reading?: boolean }
const { title, description = 'Development diary for Backseat, a relaxing music-driven VR taxi ride.', bg = 'ring', section, reading = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} · Backseat` : 'Backseat · devlog';
const path = Astro.url.pathname.replace(/\/$/, '');
const isResearch = path.endsWith('/research');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500&family=Libre+Caslon+Display&display=swap" rel="stylesheet" />
    <link rel="preload" as="image" href={`${base}/bg/${bg}.jpg`} />
    <link rel="alternate" type="application/rss+xml" title="Backseat devlog" href={`${base}/rss.xml`} />
    <title>{pageTitle}</title>
  </head>
  <body class={reading ? 'reading' : ''}>
    <div class="bg" style={`background-image:url(${base}/bg/${bg}.jpg)`} aria-hidden="true"></div>
    <header class="top cap">
      <span>{section ?? <a href={`${base}/`}>Backseat</a>}</span>
      <nav>
        <a href={`${base}/`} aria-current={!isResearch && path === base ? 'page' : undefined}>Diary</a>
        <a href={`${base}/research/`} aria-current={isResearch ? 'page' : undefined}>Research</a>
        <a href="https://github.com/JanRymarski/Backseat">GitHub</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="bottom cap">
      <span>Jan Rymarski</span>
      <span>Devine passion project — 2Ø26</span>
      <a href={`${base}/rss.xml`}>RSS</a>
    </footer>
  </body>
</html>

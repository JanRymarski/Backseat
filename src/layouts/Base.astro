---
import '../styles/global.css';
interface Props { title?: string; description?: string }
const { title, description = 'Development diary for Backseat, a music-driven VR taxi ride.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageTitle = title ? `${title} · Backseat devlog` : 'Backseat devlog';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Backseat devlog" href={`${base}/rss.xml`} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="wrap">
      <header class="site">
        <a class="logo" href={`${base}/`}>Backseat devlog</a>
        <nav>
          <a href={`${base}/`}>Diary</a>
          <a href={`${base}/research/`}>Research question</a>
          <a href="https://github.com/JanRymarski/Backseat">GitHub</a>
        </nav>
      </header>
      <main><slot /></main>
      <footer>Jan Rymarski · Devine passion project 2026</footer>
    </div>
  </body>
</html>
